DATABASE_URL=sqlite:///./smartpass.db
JWT_SECRET=change-this-to-a-long-random-secret
PHONE_LOOKUP_SECRET=change-this-phone-secret
DEMO_KEY=demo-key
DEMO_OTP_CODE=123456

# FastAPI background runtime
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=0
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_SECONDS=300

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20

# SMS / 알림톡: DEMO, SOLAPI, or HTTP
NOTIFICATION_PROVIDER=DEMO
NOTIFICATION_TIMEOUT_SECONDS=10
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_BASE_URL=https://api.solapi.com
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_ID=
NOTIFICATION_BASE_URL=
NOTIFICATION_API_TOKEN=

# Wi-Fi AP/captive portal controller: DEMO or HTTP
WIFI_NETWORK_PROVIDER=DEMO
WIFI_AP_BASE_URL=
WIFI_AP_API_TOKEN=
WIFI_AP_AUTHORIZE_PATH=/v1/sessions
WIFI_AP_REVOKE_PATH=/v1/sessions/{reference}
WIFI_AP_STATUS_PATH=/v1/sessions/{reference}
WIFI_AP_TIMEOUT_SECONDS=10

# External menu trend API: DEMO or HTTP
TREND_PROVIDER=DEMO
TREND_API_BASE_URL=
TREND_API_TOKEN=
TREND_API_TIMEOUT_SECONDS=10

# Django full backend runtime
DJANGO_SECRET_KEY=change-this-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
POSTGRES_DB=smartpass
POSTGRES_USER=smartpass
POSTGRES_PASSWORD=smartpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
